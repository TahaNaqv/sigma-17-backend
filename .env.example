# Example environment file for Sigma‑17 backend.
# Copy this to `.env` and modify values for your local or production
# environment. Do **not** check the real `.env` into source control.

# === Database settings ===
# Either supply the individual parameters below or set DATABASE_URL.
DB_NAME=sigma17
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# alternatively:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigma17

# === Django configuration ===
# Replace with a strong, unique secret key for each deployment.
SECRET_KEY=django-insecure-replace-this-with-your-own

# Set to False in production; True enables debug output.
DEBUG=True

# Hosts the app will serve.  Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# === CORS ===
# When DEBUG=False, whitelist the origins allowed to make requests.
CORS_ALLOW_ALL_ORIGINS=True  # change to False in production
CORS_ALLOWED_ORIGINS=https://sigma17.leadrisks.com,https://sigma17.netlify.app,https://sigma17.vercel.app
CSRF_TRUSTED_ORIGINS=https://sigma17.leadrisks.com,https://www.sigma17.leadrisks.com,https://sigma17.netlify.app,https://sigma17.vercel.app

# === Optional API configuration ===
# Used by the frontend to construct absolute URLs (if needed).
API_HOST=api.sigma17.leadrisks.com

# === Celery / Redis (Module 1 background jobs) ===
# Docker Compose sets redis://redis:6379/0 for web and celery services.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Worker tuning (see docs/PERFORMANCE_OPTIMIZATION_PLAN.md §3.2). Defaults are
# applied in settings.py; override here only to deviate.
CELERY_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
# Optional: recycle a worker after it exceeds this RSS in KB (0 = disabled).
CELERY_WORKER_MAX_MEMORY_PER_CHILD=0

# === Database connection reuse (see plan §3.1) ===
# Persist Postgres connections across requests/tasks. Set to 0 when running
# behind PgBouncer so the pooler owns connection lifetimes.
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=true

# === Module 1 upload limits ===
MODULE1_MAX_UPLOAD_FILES=50
MODULE1_MAX_UPLOAD_MB=200
# Output preview controls:
# - MAX_PAGE_SIZE limits requested rows per page
# - MAX_CELLS limits total returned cells in one response
MODULE1_OUTPUT_PREVIEW_DEFAULT_PAGE_SIZE=50
MODULE1_OUTPUT_PREVIEW_MAX_PAGE_SIZE=200
MODULE1_OUTPUT_PREVIEW_MAX_CELLS=20000

# === Additional settings ===
# Any other environment variables that your code reads can be added here.

# === Production security hardening (recommended when DEBUG=False) ===
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_REFERRER_POLICY=same-origin
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
